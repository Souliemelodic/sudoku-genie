function makeSolution() {
    // This creates a valid Sudoku solution
    const pattern = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    const rows = [];
    const offsets = [0, 3, 6, 1, 4, 7, 2, 5, 8];
    
    for (let r = 0; r < 9; r++) {
        const row = [];
        for (let c = 0; c < 9; c++) {
            row.push(pattern[(c + offsets[r]) % 9]);
        }
        rows.push(row);
    }
    return rows;
}
